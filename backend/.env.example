# APPLICATION
APP_NAME=EduSuggest
APP_ENV=development
DEBUG=True
API_PREFIX=/api

# DATABASE POSTGRESQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-local-password

# SQLALCHEMY
DATABASE_URL=postgresql+psycopg://postgres:replace-with-your-local-password@localhost:5432/postgres

# LOGGING
LOG_LEVEL=DEBUG
SYSTEM_LOG_FILE=logs/system.log

# SECURITY
SECRET_KEY=replace-with-a-random-development-secret
